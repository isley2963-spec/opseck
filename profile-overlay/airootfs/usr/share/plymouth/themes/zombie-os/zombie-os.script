# Zombie OS boot splash: centred radioactive logo with a slow green pulse.
# The "ZOMBIE OS" wordmark is baked into logo.png, so no fonts are needed here.

Window.SetBackgroundTopColor(0.031, 0.047, 0.035);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetPosition(logo.x, logo.y, 10);

frame = 0;

fun refresh_callback() {
    frame++;
    # smooth pulse between 70% and 100% opacity
    opacity = 0.85 + 0.15 * Math.Sin(frame / 18.0);
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);
